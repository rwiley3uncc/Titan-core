{
  "mode_id": "student_ops",
  "display_name": "Titan Student Mode",
  "purpose": "Local-first student operations assistant for class sitrep, study planning, course-material Q&A, and schedule-aware prioritization.",
  "behavior_rules": {
    "teach_and_explain": true,
    "allow_concept_guidance": true,
    "allow_quiz_practice_generation": true,
    "require_source_honesty": true,
    "require_missing_info_disclosure": true,
    "forbid_direct_graded_work_completion": true,
    "forbid_hidden_tool_execution": true,
    "forbid_autonomous_remediation": true,
    "forbid_live_apply": true
  },
  "local_course_workspace_root": "Titan-core/data/courses",
  "source_policy": {
    "local_first": true,
    "read_only_course_materials": true,
    "cite_sources_when_available": true,
    "no_hidden_web_calls": true
  },
  "retrieval_policy": {
    "enabled": true,
    "local_only": true,
    "read_only": true,
    "supported_extensions": [
      ".pdf",
      ".md",
      ".txt"
    ],
    "persistent_background_indexing": false
  }
}
